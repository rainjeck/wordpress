/*!
 * === UI =======================================
 */

.is-loading
    position: relative;

    &:before
        pseudo();
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        background-color: rgba(#fff, 0.5);
        z-index: 10;

    &:after
        pseudo();
        width: 40px;
        height: 40px;
        border-radius: 100%;
        top: 50%;
        left: 50%;
        margin-top: -20px;
        margin-left: -20px;
        border-width: 5px;
        border-color: #111827 #E5E7EB;
        border-style: solid;
        animation: loading-rotate 1s ease-in-out infinite forwards;
        z-index: 15;

@keyframes loading-rotate
    from
        transform: rotate(0);
    to
        transform: rotate(360deg);

@import 'framework';

/*!
 * --- ELEMENTS BASIC ---------------------------
 */

.v-icon
    flex: none;
    bg(center, contain);

    .ico
        max-width: 100%;
        max-height: 100%;

.v-pic-bg
    position: absolute;
    size(100%, 100%);
    top: 0;
    left: 0;

    img
        size(100%, 100%);
        object-fit: cover;

.v-img-cover
    img
        size(100%, 100%);
        object-fit: cover;

.v-img-contain
    img
        size(100%, 100%);
        object-fit: contain;

.v-ratio
    overflow: hidden;
    position: relative;
    width: 100%;

    img, iframe, .img
        border: 0;
        height: 100%;
        left: 0;
        position: absolute;
        top: 0;
        width: 100%;

    &.is-1
        padding-top: 100%;

    &.is-169
        padding-top: round((9 / 16) * 100%, 2);

    &.is-43
        padding-top: round((3 / 4) * 100%, 2);

    &.is-53
        padding-top: round((3 / 5) * 100%, 2);

.v-tab
    display: none;
    opacity: 0;

    &.is-active
        display: block;
        animation: tab-show 1s linear 0.01s 1 forwards;

@keyframes tab-show
    from
        opacity: 0;
    to
        opacity: 1;

.v-ul-clear
    padding: 0;
    margin: 0;
    list-style-type: none;


/*!
* --- COLORS ------------------------------------
*/

for $name, $color in $color_vars
    .v-bg-{$name}
        background-color: $color;

    .v-fill-{$name}
        fill: $color;

    .v-color-{$name}
        color: $color;

    .v-stroke-{$name}
        border-style: solid;
        border-color: $color;


for $one in 1
    .v-border-{$one}
        border-width: unit($one,'px');


/*!
* --- FORM --------------------------------------
*/

.v-form
    .v-form-result-success,
    .v-form-result-error
        display: none;

    &.is-success .v-form-result-success
        display: block;

    &.is-error .v-form-result-error
        display: block;

    .error-message
        font-size: 0.7em;
        color: $colorError;

.v-fg
    position: relative;

    .error-message
        position: absolute;
        bottom: 3px;
        right: 5px;

    &.is-cbx .v-status-error
        bottom: auto;
        top: 100%;
        right: 0;

.v-select
    select
        appearance: none;

        &::-ms-expand
            display: none;

.v-input
    height: 2em;
    border: 1px solid $colorText;

.v-cbx
    position: relative;

    input
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        z-index: -1;

    &-wrapper
        cursor: pointer;

    &-box
        size(1em, 1em);
        border: 1px solid $colorAccent;

    input:checked ~ &-box
        background-color: $colorAccent;

    &.is-radio &-box
        border-radius: 100px;
        size(18px, 18px);


/*!
* --- ELEMENTS ----------------------------------
*/

.v-burger
    size(32px, 24px);
    position: relative;

    &:before, &:after
        pseudo();

    &:before, &:after, span
        width: 100%;
        height: 4px;
        left: 0;
        background: red;
        border-radius: 10px;
        transit();

    &:before
        top: 0;

    &:after
        top: 100%;
        margin-top: -4px;

    span
        top: 50%;
        margin-top: 0;

    &.is-active
        span
            opacity: 0;

        &:before, &:after
            top: 50%;
            margin-top: -2px;

        &:before
            transform: rotate(45deg);

        &:after
            transform: rotate(-45deg);

.link
    transit();

    &:hover
        opacity: 0.6;

.v-link-zoom
    cursor: zoom-in;


.v-hr
    border: 0;
    border-bottom-width: 1px;
    border-bottom-style: solid;


/*!
* --- TEXT --------------------------------------
*/

// Font Weight
for $one in 400 500 600 700 800
    .v-fw-{$one}
        font-weight: $one;

// Line Height
.v-lh-auto
    line-height: normal;

for $one in 100 150
    .v-lh-{$one}
        line-height: round(($one/100),2);

// for $one in 40 60
//     .v-opacity-{$one}
//         opacity: (60/100);

.v-tt-upper
    text-transform: uppercase;

.v-td-underline
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;

.v-txt
    h1, h2, h3, h4
        &:not(:first-child)
            margin-top: 1.4em;

        &:not(:last-child)
            margin-bottom: 0.4em;

    h4
        font-size: 1em;
    h3
        font-size: 1.1em;
    h2
        font-size: 1.2em;
    h1
        font-size: 1.3em;

    p
        &:not(:last-child)
            margin-bottom: 1em;

    ul, ol
        padding-left: 1.5em;

        &:not(:first-child)
            margin-top: 1em;

        &:not(:last-child)
            margin-bottom: 2em;
